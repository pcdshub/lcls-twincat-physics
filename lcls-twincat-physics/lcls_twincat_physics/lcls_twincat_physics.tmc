        <Type>UDINT</Type>
        <Comment> Contains the high-value 4 bytes of the numerical value </Comment>
        <BitSize>32</BitSize>
        <BitOffs>96</BitOffs>
        <Properties>
          <Property>
            <Name>ItemType</Name>
            <Value>Output</Value>
          </Property>
        </Properties>
      </SubItem>
